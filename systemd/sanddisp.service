[Unit]
Description=Sanddisp Display
# After=qmidinet.service
# Wants=qmidinet.service

[Service]
WorkingDirectory=/home/sandbells/Code/Sanddisp
Type=simple
User=sandbells
ExecStart=/home/sandbells/Code/Sanddisp/venv/bin/python /home/sandbells/Code/Sanddisp/sanddisp_usb.py
# ExecStart=/home/sandbells/start.sh
Restart=on-failure
TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
